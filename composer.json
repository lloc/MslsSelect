{
  "name": "lloc/msls-select",
  "description": "Transforms the output of the Multisite Language Switcher to an HTML select",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://it.wordpress.org/plugins/mslsselect/",
  "require": {
    "php": ">=7.4",
    "composer/installers": "~1.9.0"
  },
  "autoload-dev": {
    "classmap": [
      "MslsSelect.php"
    ]
  },
  "require-dev": {
    "brain/monkey": "^2.7.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan": "^2.2.0",
    "phpunit/phpunit": "~9.6",
    "szepeviktor/phpstan-wordpress": "^2.0.0",
    "wp-coding-standards/wpcs": "^3.0",
    "lloc/composer-i18n-scripts": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "scripts": {
    "phpcs": "phpcs -p ./*.php --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 7.4-",
    "phpstan": "vendor/bin/phpstan analyze --memory-limit=2G",
    "phpunit": "@php vendor/bin/phpunit",
    "qa": [
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ],
    "phpunit:html": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage",
    "git-release": "bin/git-release.sh",
    "build": [
      "@composer install --no-dev --prefer-dist --optimize-autoloader",
      "@git-release",
      "@composer update --prefer-dist --optimize-autoloader"
    ],
    "githooks": [
      "if [ -e bin/githooks/pre-commit ]; then cp bin/githooks/pre-commit ./.git/hooks/; fi",
      "if [ -e .git/hooks/pre-commit ]; then chmod 0755 .git/hooks/pre-commit; fi"
    ],
    "post-install-cmd": [
      "@githooks"
    ],
    "post-update-cmd": [
      "@githooks"
    ]
  },
  "authors": [
    {
      "name": "Dennis Ploetner",
      "email": "re@lloc.de",
      "homepage": "http://lloc.de"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "lloc/composer-i18n-scripts": true
    }
  }
}
